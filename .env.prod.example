# =============================================================
# InfraPilot Production Environment Configuration
# =============================================================
#
# Copy this file to .env and configure for your environment:
#   cp .env.prod.example .env
#
# IMPORTANT: Generate strong secrets for production!
#
# =============================================================

# -------------------------------------------------------------
# Version
# -------------------------------------------------------------
VERSION=latest

# -------------------------------------------------------------
# Ports
# -------------------------------------------------------------
HTTP_PORT=80
HTTPS_PORT=443

# -------------------------------------------------------------
# Security (REQUIRED)
# -------------------------------------------------------------
# Generate with: openssl rand -base64 32
JWT_SECRET=

# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=

# Generate with: openssl rand -base64 32
REDIS_PASSWORD=

# Generate with: openssl rand -hex 32
# Used for encrypting webhook secrets, registry credentials, and SSO secrets
ENCRYPTION_KEY=

# -------------------------------------------------------------
# Database
# -------------------------------------------------------------
POSTGRES_USER=infrapilot
POSTGRES_DB=infrapilot

# -------------------------------------------------------------
# SSL/TLS (Let's Encrypt)
# -------------------------------------------------------------
# Your email for Let's Encrypt notifications
LETSENCRYPT_EMAIL=admin@yourdomain.com

# Set to false for production certificates
LETSENCRYPT_STAGING=true

# -------------------------------------------------------------
# CORS Origins
# -------------------------------------------------------------
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost,https://localhost,https://yourdomain.com

# -------------------------------------------------------------
# Agent Configuration
# -------------------------------------------------------------
# Default agent ID (for single-node deployments)
# For multi-agent setups, use enrollment tokens instead
AGENT_ID=00000000-0000-0000-0000-000000000001

# -------------------------------------------------------------
# Optional: External Services
# -------------------------------------------------------------
# If you want to use external PostgreSQL/Redis instead of containers,
# uncomment and configure these:

# DATABASE_URL=postgres://user:password@external-host:5432/dbname?sslmode=require
# REDIS_URL=redis://:password@external-host:6379
